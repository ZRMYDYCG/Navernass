generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  user
  super_admin
}

enum NovelStatus {
  draft
  published
  archived
}

enum ChapterStatus {
  draft
  published
}

enum NewsType {
  feature
  update
  announcement
  community
}

enum NewsStatus {
  draft
  published
  archived
}

enum TodoPriority {
  low
  medium
  high
}

enum WorldCategory {
  setting
  location
  item
  faction
  event
  rule
  character_lore
  other
}

enum TimelineType {
  appearance
  milestone
  relation
  conflict
  growth
  death
  other
}

enum AiProviderKind {
  openai
  anthropic
  google
  deepseek
  qwen
  glm
  compatible
}

enum AgentRole {
  main
  character
  plot
  world
  style
  reviewer
}

enum AgentRunStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum MemoryKind {
  chapter
  character
  worldbook
  outline
  timeline
  summary
  conversation
  custom
}

enum AgentMessageRole {
  user
  assistant
  system
  tool
}

enum SkillSource {
  builtin
  community
  custom
}

enum SkillStatus {
  draft
  published
  disabled
}

model User {
  id                String             @id @default(uuid()) @db.VarChar(36)
  name              String             @db.VarChar(191)
  email             String             @unique @db.VarChar(191)
  emailVerified     Boolean            @default(false)
  image             String?            @db.Text
  createdAt         DateTime           @default(now()) @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @db.DateTime(3)
  sessions          Session[]
  accounts          Account[]
  profile           Profile?
  novels            Novel[]
  surveys           Survey[]
  todos             WriterTodo[]
  ai_providers      AiProviderConfig[]
  agent_sessions    AgentSession[]
  agent_runs        AgentRun[]
  semantic_memories SemanticMemory[]
  a2a_tasks         A2aTask[]
  agent_messages    AgentMessage[]
  skill_defs        SkillDef[]
  skill_installs    SkillInstall[]
  novel_skills      NovelSkill[]

  @@map("auth_users")
}

model Session {
  id        String   @id @default(uuid()) @db.VarChar(36)
  expiresAt DateTime @db.DateTime(3)
  token     String   @unique @db.VarChar(191)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  ipAddress String?  @db.VarChar(191)
  userAgent String?  @db.Text
  userId    String   @db.VarChar(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.VarChar(36)
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(191)
  userId                String    @db.VarChar(36)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.DateTime(3)
  refreshTokenExpiresAt DateTime? @db.DateTime(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @db.DateTime(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.VarChar(36)
  identifier String   @db.VarChar(191)
  value      String   @db.Text
  expiresAt  DateTime @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  @@index([identifier])
  @@map("auth_verifications")
}

model Profile {
  id                   String   @id @db.VarChar(36)
  username             String?  @unique @db.VarChar(64)
  full_name            String?  @db.VarChar(191)
  avatar_url           String?  @db.Text
  website              String?  @db.Text
  legacy_password_hash String?  @db.Text
  role                 UserRole @default(user)
  is_protected         Boolean  @default(false)
  created_at           DateTime @default(now()) @db.DateTime(3)
  updated_at           DateTime @updatedAt @db.DateTime(3)
  user                 User     @relation(fields: [id], references: [id], onDelete: Cascade)

  @@index([role])
  @@map("profiles")
}

model Novel {
  id                String           @id @default(uuid()) @db.VarChar(36)
  user_id           String           @db.VarChar(36)
  title             String           @db.VarChar(255)
  description       String?          @db.Text
  cover             String?          @db.Text
  category          String?          @db.VarChar(100)
  tags              Json
  word_count        Int              @default(0)
  chapter_count     Int              @default(0)
  status            NovelStatus      @default(draft)
  characters        Json
  relationships     Json
  order_index       Int              @default(0)
  created_at        DateTime         @default(now()) @db.DateTime(3)
  updated_at        DateTime         @updatedAt @db.DateTime(3)
  published_at      DateTime?        @db.DateTime(3)
  user              User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  volumes           Volume[]
  chapters          Chapter[]
  worldbook         WorldbookEntry[]
  outlines          Outline[]
  plan_files        PlanFile[]
  timeline_events   TimelineEvent[]
  agent_sessions    AgentSession[]
  agent_runs        AgentRun[]
  semantic_memories SemanticMemory[]
  agent_messages    AgentMessage[]
  novel_skills      NovelSkill[]

  @@index([user_id, status, order_index])
  @@map("novels")
}

model Volume {
  id          String    @id @default(uuid()) @db.VarChar(36)
  novel_id    String    @db.VarChar(36)
  user_id     String    @db.VarChar(36)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  order_index Int
  created_at  DateTime  @default(now()) @db.DateTime(3)
  updated_at  DateTime  @updatedAt @db.DateTime(3)
  deleted_at  DateTime? @db.DateTime(3)
  novel       Novel     @relation(fields: [novel_id], references: [id], onDelete: Cascade)
  chapters    Chapter[]
  outlines    Outline[]

  @@index([novel_id, deleted_at, order_index])
  @@index([user_id])
  @@map("volumes")
}

model Chapter {
  id              String          @id @default(uuid()) @db.VarChar(36)
  novel_id        String          @db.VarChar(36)
  volume_id       String?         @db.VarChar(36)
  user_id         String          @db.VarChar(36)
  title           String          @db.VarChar(255)
  content         String          @db.LongText
  summary         String?         @db.Text
  order_index     Int
  word_count      Int             @default(0)
  status          ChapterStatus   @default(draft)
  created_at      DateTime        @default(now()) @db.DateTime(3)
  updated_at      DateTime        @updatedAt @db.DateTime(3)
  deleted_at      DateTime?       @db.DateTime(3)
  novel           Novel           @relation(fields: [novel_id], references: [id], onDelete: Cascade)
  volume          Volume?         @relation(fields: [volume_id], references: [id], onDelete: SetNull)
  timeline_events TimelineEvent[]

  @@index([novel_id, deleted_at, order_index])
  @@index([volume_id, deleted_at, order_index])
  @@index([user_id])
  @@map("chapters")
}

model WorldbookEntry {
  id          String        @id @default(uuid()) @db.VarChar(36)
  user_id     String        @db.VarChar(36)
  novel_id    String        @db.VarChar(36)
  category    WorldCategory @default(other)
  title       String        @db.VarChar(255)
  content     String        @db.LongText
  keywords    Json
  order_index Int           @default(0)
  created_at  DateTime      @default(now()) @db.DateTime(3)
  updated_at  DateTime      @updatedAt @db.DateTime(3)
  deleted_at  DateTime?     @db.DateTime(3)
  novel       Novel         @relation(fields: [novel_id], references: [id], onDelete: Cascade)

  @@index([novel_id, deleted_at, order_index])
  @@index([user_id])
  @@map("worldbook_entries")
}

model Outline {
  id          String    @id @default(uuid()) @db.VarChar(36)
  user_id     String    @db.VarChar(36)
  novel_id    String    @db.VarChar(36)
  volume_id   String?   @db.VarChar(36)
  parent_id   String?   @db.VarChar(36)
  title       String    @db.VarChar(255)
  content     String    @db.LongText
  order_index Int       @default(0)
  created_at  DateTime  @default(now()) @db.DateTime(3)
  updated_at  DateTime  @updatedAt @db.DateTime(3)
  deleted_at  DateTime? @db.DateTime(3)
  novel       Novel     @relation(fields: [novel_id], references: [id], onDelete: Cascade)
  volume      Volume?   @relation(fields: [volume_id], references: [id], onDelete: SetNull)
  parent      Outline?  @relation("OutlineTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children    Outline[] @relation("OutlineTree")

  @@index([novel_id, deleted_at, order_index])
  @@index([volume_id, deleted_at])
  @@index([parent_id])
  @@map("outlines")
}

model PlanFile {
  id          String    @id @default(uuid()) @db.VarChar(36)
  user_id     String    @db.VarChar(36)
  novel_id    String    @db.VarChar(36)
  path        String    @db.VarChar(255)
  name        String    @db.VarChar(255)
  content     String    @db.LongText
  order_index Int       @default(0)
  created_at  DateTime  @default(now()) @db.DateTime(3)
  updated_at  DateTime  @updatedAt @db.DateTime(3)
  deleted_at  DateTime? @db.DateTime(3)
  novel       Novel     @relation(fields: [novel_id], references: [id], onDelete: Cascade)

  @@unique([novel_id, path])
  @@index([novel_id, deleted_at, order_index])
  @@index([user_id])
  @@map("plan_files")
}

model TimelineEvent {
  id                String       @id @default(uuid()) @db.VarChar(36)
  user_id           String       @db.VarChar(36)
  novel_id          String       @db.VarChar(36)
  character_id      String       @db.VarChar(36)
  chapter_id        String?      @db.VarChar(36)
  event_type        TimelineType @default(other)
  title             String       @db.VarChar(255)
  description       String       @db.Text
  timeline_position Int          @default(0)
  occurred_at_label String?      @db.VarChar(191)
  created_at        DateTime     @default(now()) @db.DateTime(3)
  updated_at        DateTime     @updatedAt @db.DateTime(3)
  deleted_at        DateTime?    @db.DateTime(3)
  novel             Novel        @relation(fields: [novel_id], references: [id], onDelete: Cascade)
  chapter           Chapter?     @relation(fields: [chapter_id], references: [id], onDelete: SetNull)

  @@index([character_id, deleted_at, timeline_position])
  @@index([novel_id, deleted_at])
  @@map("character_timeline_events")
}

model News {
  id         String     @id @default(uuid()) @db.VarChar(36)
  type       NewsType
  title      String     @db.VarChar(255)
  content    String     @db.LongText
  image      String?    @db.Text
  link       String?    @db.Text
  author     String?    @db.VarChar(191)
  status     NewsStatus @default(published)
  priority   Int        @default(0)
  read_count Int        @default(0)
  created_at DateTime   @default(now()) @db.DateTime(3)
  updated_at DateTime   @updatedAt @db.DateTime(3)

  @@index([status, priority, created_at])
  @@map("news")
}

model Survey {
  id              String   @id @default(uuid()) @db.VarChar(36)
  user_id         String?  @db.VarChar(36)
  experience      String   @db.VarChar(191)
  genres          Json
  pain_points     Json
  tools           Json
  ai_expectations Json
  ai_concerns     String?  @db.Text
  contact         String?  @db.VarChar(255)
  created_at      DateTime @default(now()) @db.DateTime(3)
  user            User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@map("surveys")
}

model WriterTodo {
  id         String       @id @default(uuid()) @db.VarChar(36)
  user_id    String       @db.VarChar(36)
  content    String       @db.Text
  completed  Boolean      @default(false)
  priority   TodoPriority @default(medium)
  created_at DateTime     @default(now()) @db.DateTime(3)
  updated_at DateTime     @updatedAt @db.DateTime(3)
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, completed, created_at])
  @@map("writer_todos")
}

model MessageWallEntry {
  id         String   @id @default(uuid()) @db.VarChar(36)
  nickname   String?  @db.VarChar(64)
  message    String   @db.VarChar(180)
  created_at DateTime @default(now()) @db.DateTime(3)

  @@index([created_at])
  @@map("message_wall_entries")
}

model AiProviderConfig {
  id                  String         @id @default(uuid()) @db.VarChar(36)
  user_id             String         @db.VarChar(36)
  name                String         @db.VarChar(100)
  kind                AiProviderKind
  base_url            String?        @db.VarChar(500)
  api_key_cipher      String         @db.LongText
  model               String         @db.VarChar(191)
  embedding_model     String?        @db.VarChar(191)
  supports_tools      Boolean        @default(true)
  supports_structured Boolean        @default(true)
  is_default          Boolean        @default(false)
  is_enabled          Boolean        @default(true)
  settings            Json
  created_at          DateTime       @default(now()) @db.DateTime(3)
  updated_at          DateTime       @updatedAt @db.DateTime(3)
  user                User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sessions            AgentSession[]
  runs                AgentRun[]

  @@unique([user_id, name])
  @@index([user_id, is_default, is_enabled])
  @@map("ai_provider_configs")
}

model AgentSession {
  id          String           @id @default(uuid()) @db.VarChar(36)
  user_id     String           @db.VarChar(36)
  novel_id    String           @db.VarChar(36)
  chapter_id  String?          @db.VarChar(36)
  provider_id String           @db.VarChar(36)
  title       String?          @db.VarChar(255)
  context     Json
  created_at  DateTime         @default(now()) @db.DateTime(3)
  updated_at  DateTime         @updatedAt @db.DateTime(3)
  user        User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  novel       Novel            @relation(fields: [novel_id], references: [id], onDelete: Cascade)
  provider    AiProviderConfig @relation(fields: [provider_id], references: [id], onDelete: Restrict)
  runs        AgentRun[]
  messages    AgentMessage[]

  @@index([user_id, updated_at])
  @@index([novel_id, chapter_id])
  @@map("agent_sessions")
}

model AgentRun {
  id               String           @id @default(uuid()) @db.VarChar(36)
  session_id       String?          @db.VarChar(36)
  user_id          String           @db.VarChar(36)
  novel_id         String           @db.VarChar(36)
  chapter_id       String?          @db.VarChar(36)
  provider_id      String           @db.VarChar(36)
  role             AgentRole        @default(main)
  status           AgentRunStatus   @default(queued)
  prompt           String           @db.LongText
  output           String?          @db.LongText
  context_snapshot Json
  skill_ids        Json?
  skill_snapshot   Json?
  input_tokens     Int              @default(0)
  output_tokens    Int              @default(0)
  total_tokens     Int              @default(0)
  finish_reason    String?          @db.VarChar(100)
  error_code       String?          @db.VarChar(100)
  error_message    String?          @db.Text
  latency_ms       Int?
  started_at       DateTime?        @db.DateTime(3)
  completed_at     DateTime?        @db.DateTime(3)
  created_at       DateTime         @default(now()) @db.DateTime(3)
  user             User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  novel            Novel            @relation(fields: [novel_id], references: [id], onDelete: Cascade)
  provider         AiProviderConfig @relation(fields: [provider_id], references: [id], onDelete: Restrict)
  session          AgentSession?    @relation(fields: [session_id], references: [id], onDelete: SetNull)
  steps            AgentStep[]
  tool_calls       AgentToolCall[]
  messages         AgentMessage[]

  @@index([user_id, created_at])
  @@index([novel_id, chapter_id, created_at])
  @@index([session_id, created_at])
  @@index([status, created_at])
  @@map("agent_runs")
}

/// 按小说和会话保存的完整聊天消息，parts 保留 AI SDK UIMessagePart 原始结构。
model AgentMessage {
  id         String           @id @default(uuid()) @db.VarChar(36)
  session_id String           @db.VarChar(36)
  run_id     String?          @db.VarChar(36)
  user_id    String           @db.VarChar(36)
  novel_id   String           @db.VarChar(36)
  chapter_id String?          @db.VarChar(36)
  remote_id  String?          @db.VarChar(191)
  role       AgentMessageRole
  content    String           @db.LongText
  parts      Json
  metadata   Json
  created_at DateTime         @default(now()) @db.DateTime(3)
  session    AgentSession     @relation(fields: [session_id], references: [id], onDelete: Cascade)
  run        AgentRun?        @relation(fields: [run_id], references: [id], onDelete: SetNull)
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  novel      Novel            @relation(fields: [novel_id], references: [id], onDelete: Cascade)

  @@index([session_id, created_at, id])
  @@index([user_id, novel_id, created_at])
  @@index([run_id])
  @@index([remote_id])
  @@map("agent_messages")
}

/// Skill 定义只保存声明式 SKILL.md，不允许持久化或执行任意代码。
model SkillDef {
  id           String         @id @db.VarChar(64)
  slug         String         @db.VarChar(64)
  owner_id     String?        @db.VarChar(36)
  display_name String         @db.VarChar(100)
  description  String         @db.VarChar(1024)
  category     String         @default("writing-style") @db.VarChar(64)
  source       SkillSource    @default(custom)
  license      String         @default("user") @db.VarChar(32)
  skill_md     String         @db.LongText
  manifest     Json
  version      String         @default("1.0.0") @db.VarChar(32)
  checksum     String         @db.Char(64)
  is_builtin   Boolean        @default(false)
  status       SkillStatus    @default(draft)
  created_at   DateTime       @default(now()) @db.DateTime(3)
  updated_at   DateTime       @updatedAt @db.DateTime(3)
  owner        User?          @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  installs     SkillInstall[]
  novels       NovelSkill[]

  @@unique([owner_id, slug])
  @@index([source, status, is_builtin])
  @@map("skill_defs")
}

model SkillInstall {
  id           String   @id @default(uuid()) @db.VarChar(36)
  user_id      String   @db.VarChar(36)
  skill_id     String   @db.VarChar(64)
  enabled      Boolean  @default(true)
  config       Json
  installed_at DateTime @default(now()) @db.DateTime(3)
  updated_at   DateTime @updatedAt @db.DateTime(3)
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  skill        SkillDef @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([user_id, skill_id])
  @@index([user_id, enabled])
  @@map("skill_installs")
}

model NovelSkill {
  id         String   @id @default(uuid()) @db.VarChar(36)
  user_id    String   @db.VarChar(36)
  novel_id   String   @db.VarChar(36)
  skill_id   String   @db.VarChar(64)
  enabled    Boolean  @default(true)
  priority   Int      @default(0)
  config     Json
  created_at DateTime @default(now()) @db.DateTime(3)
  updated_at DateTime @updatedAt @db.DateTime(3)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  novel      Novel    @relation(fields: [novel_id], references: [id], onDelete: Cascade)
  skill      SkillDef @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([novel_id, skill_id])
  @@index([user_id, novel_id, enabled, priority])
  @@map("novel_skills")
}

model AgentStep {
  id              String          @id @default(uuid()) @db.VarChar(36)
  run_id          String          @db.VarChar(36)
  step_index      Int
  role            AgentRole
  finish_reason   String?         @db.VarChar(100)
  input_tokens    Int             @default(0)
  output_tokens   Int             @default(0)
  tool_call_count Int             @default(0)
  metadata        Json
  created_at      DateTime        @default(now()) @db.DateTime(3)
  run             AgentRun        @relation(fields: [run_id], references: [id], onDelete: Cascade)
  tool_calls      AgentToolCall[]

  @@unique([run_id, step_index])
  @@map("agent_steps")
}

model AgentToolCall {
  id            String     @id @default(uuid()) @db.VarChar(36)
  run_id        String     @db.VarChar(36)
  step_id       String?    @db.VarChar(36)
  tool_call_id  String     @db.VarChar(191)
  tool_name     String     @db.VarChar(100)
  input         Json
  output        Json?
  status        String     @db.VarChar(32)
  duration_ms   Int?
  error_message String?    @db.Text
  created_at    DateTime   @default(now()) @db.DateTime(3)
  run           AgentRun   @relation(fields: [run_id], references: [id], onDelete: Cascade)
  step          AgentStep? @relation(fields: [step_id], references: [id], onDelete: SetNull)

  @@unique([run_id, tool_call_id])
  @@index([run_id, tool_name])
  @@map("agent_tool_calls")
}

model SemanticMemory {
  id           String     @id @default(uuid()) @db.VarChar(36)
  user_id      String     @db.VarChar(36)
  novel_id     String     @db.VarChar(36)
  chapter_id   String?    @db.VarChar(36)
  source_id    String?    @db.VarChar(36)
  vector_id    String     @unique @db.VarChar(36)
  kind         MemoryKind
  title        String?    @db.VarChar(255)
  content      String     @db.LongText
  content_hash String     @db.Char(64)
  metadata     Json
  created_at   DateTime   @default(now()) @db.DateTime(3)
  updated_at   DateTime   @updatedAt @db.DateTime(3)
  user         User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  novel        Novel      @relation(fields: [novel_id], references: [id], onDelete: Cascade)

  @@unique([novel_id, kind, source_id])
  @@index([user_id, novel_id, kind])
  @@index([chapter_id])
  @@map("semantic_memories")
}

/// A2A v1 任务快照。协议对象完整保存在 payload 中，索引字段用于租户隔离与游标分页。
model A2aTask {
  id         String   @id @db.VarChar(191)
  user_id    String   @db.VarChar(36)
  context_id String   @db.VarChar(191)
  state      String   @db.VarChar(64)
  payload    Json
  created_at DateTime @default(now()) @db.DateTime(3)
  updated_at DateTime @updatedAt @db.DateTime(3)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, updated_at, id])
  @@index([user_id, context_id, updated_at])
  @@index([user_id, state, updated_at])
  @@map("a2a_tasks")
}
