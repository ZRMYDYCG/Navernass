NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

DATABASE_URL=mysql://narraverse:narraverse@localhost:3307/narraverse
DATABASE_HOST=localhost
DATABASE_PORT=3307
DATABASE_USER=narraverse
DATABASE_PASSWORD=narraverse
DATABASE_NAME=narraverse
DATABASE_POOL_SIZE=10
MYSQL_EXPOSE_PORT=3307

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
APP_URL=http://localhost:3000
SUPER_ADMIN_EMAIL=admin@example.com

# AI Provider 密钥的服务端加密主密钥，请使用密码管理器生成独立随机值
AI_CONFIG_SECRET=replace-with-at-least-32-random-characters
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_MS=180000
AGENT_MAX_RETRIES=2
AGENT_RETRY_BASE_MS=500
AGENT_RETRY_MAX_MS=10000
AGENT_CONTEXT_MAX_CHARS=120000

# 联调期临时写死的 AI 配置（baseURL 不能带 /chat/completions，SDK 会自动拼接）
AI_DEV_BASE_URL=https://api.302.ai/v1
AI_DEV_API_KEY=replace-with-your-api-key
AI_DEV_MODEL=glm-5.3-flash

# 语义记忆向量库
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=narraverse_memory
