# 复制为 .env.local 并填入真实值
# cp .env.example .env.local

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# 公开阅读页读取已发布章节（可选；未配置时回退到用户 session）
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── LLM（编辑器 AI 对话 / Agent，OpenAI 兼容）──────────────
LLM_PROVIDER=minimax
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M3
TAVILY_API_KEY=your-tavily-api-key

# ── 站点 ──────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Nest 后端（渐进迁移）──────────────────────────────────
NEST_API_URL=http://127.0.0.1:3001/api/v1
NEXT_PUBLIC_NEST_BACKEND_ENABLED=false
PORT=3001
CORS_ORIGINS=http://localhost:3000

# 独立后端：MySQL + Better Auth
DATABASE_URL=mysql://narraverse:narraverse@localhost:3306/narraverse
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=narraverse
DATABASE_PASSWORD=narraverse
DATABASE_NAME=narraverse
DATABASE_POOL_SIZE=10
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
APP_URL=http://localhost:3000

# ── 超级管理员 ────────────────────────────────────────────
# 指定邮箱在登录后自动获得不可删除的超级管理员权限，并可访问 /admin
SUPER_ADMIN_EMAIL=your-admin@example.com
