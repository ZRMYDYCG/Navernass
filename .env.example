# 复制为 .env.local 并填入真实值
# cp .env.example .env.local

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# 公开阅读页读取已发布章节（可选；未配置时回退到用户 session）
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── LLM（编辑器 AI 对话 / Agent，OpenAI 兼容）──────────────
LLM_PROVIDER=minimax
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M2.7

# ── 硅基流动（章节摘要、图片生成等，可选）──────────────────
# 用户也可在应用设置中配置个人 API Key
SILICON_FLOW_API_KEY=
SILICON_FLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICON_FLOW_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# ── 站点 ──────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

