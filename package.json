{
  "name": "narraverse",
  "version": "0.17.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZRMYDYCG/Navernass.git"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "pnpm --filter @narraverse/frontend dev",
    "dev:frontend": "pnpm --filter @narraverse/frontend dev",
    "dev:web": "pnpm --filter @narraverse/web dev",
    "dev:backend": "pnpm --filter @narraverse/backend dev",
    "dev:server": "pnpm --filter @narraverse/backend dev",
    "dev:all": "pnpm --parallel --filter @narraverse/frontend --filter @narraverse/backend run dev",
    "build": "pnpm --filter @narraverse/frontend build",
    "build:frontend": "pnpm --filter @narraverse/frontend build",
    "build:web": "pnpm --filter @narraverse/web build",
    "build:backend": "pnpm --filter @narraverse/backend build",
    "build:server": "pnpm --filter @narraverse/backend build",
    "build:all": "pnpm -r --filter @narraverse/frontend --filter @narraverse/backend run build",
    "start": "pnpm --filter @narraverse/frontend start",
    "analyze": "pnpm --filter @narraverse/web analyze",
    "db:link": "supabase link --project-ref $env:SUPABASE_PROJECT_REF",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:diff": "supabase db diff --linked -f",
    "db:reset": "supabase db reset --linked",
    "db:migration:new": "supabase migration new",
    "db:migration:list": "supabase migration list --linked",
    "db:migration:repair": "supabase migration repair --status applied",
    "db:types": "supabase gen types typescript --linked > apps/web/lib/supabase/database.types.ts",
    "lint": "oxlint apps/frontend apps/backend",
    "lint:fix": "oxlint --fix apps/frontend apps/backend",
    "format": "oxfmt --check apps/frontend apps/backend",
    "format:fix": "oxfmt apps/frontend apps/backend",
    "typecheck": "pnpm --filter @narraverse/frontend typecheck",
    "typecheck:frontend": "pnpm --filter @narraverse/frontend typecheck",
    "typecheck:web": "pnpm --filter @narraverse/web typecheck",
    "typecheck:backend": "pnpm --filter @narraverse/backend typecheck",
    "typecheck:server": "pnpm --filter @narraverse/backend typecheck",
    "typecheck:all": "pnpm -r --filter @narraverse/frontend --filter @narraverse/backend run typecheck",
    "commit": "git-cz",
    "prepare": "lefthook install",
    "release": "release-it",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:patch": "release-it patch",
    "release:beta": "release-it --preRelease=beta",
    "release:dry": "release-it --dry-run"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@release-it/conventional-changelog": "^8.0.2",
    "@shadcn/lint": "^0.1.1",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "lefthook": "^2.0.2",
    "lint-staged": "^16.2.6",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "release-it": "^17.9.0",
    "supabase": "^2.102.0",
    "typescript": "^5"
  }
}
