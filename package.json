{
  "name": "narraverse",
  "version": "0.17.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZRMYDYCG/Navernass.git"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "pnpm --filter @narraverse/frontend dev",
    "dev:backend": "pnpm --filter @narraverse/backend dev",
    "dev:desktop": "pnpm --filter @narraverse/desktop dev",
    "dev:mobile": "pnpm --filter @narraverse/mobile dev",
    "dev:all": "pnpm --parallel --filter @narraverse/frontend --filter @narraverse/backend run dev",
    "build": "pnpm --filter @narraverse/frontend build",
    "build:backend": "pnpm --filter @narraverse/backend build",
    "build:desktop": "pnpm --filter @narraverse/desktop build",
    "build:mobile": "pnpm --filter @narraverse/mobile export:web",
    "build:all": "pnpm -r --filter @narraverse/frontend --filter @narraverse/backend run build",
    "start": "pnpm --filter @narraverse/frontend start",
    "lint": "oxlint apps/frontend apps/backend apps/desktop apps/mobile",
    "lint:fix": "oxlint --fix apps/frontend apps/backend apps/desktop apps/mobile",
    "format": "oxfmt --check apps/frontend apps/backend apps/desktop apps/mobile",
    "format:fix": "oxfmt apps/frontend apps/backend apps/desktop apps/mobile",
    "typecheck": "pnpm --filter @narraverse/frontend typecheck",
    "typecheck:backend": "pnpm --filter @narraverse/backend typecheck",
    "typecheck:desktop": "pnpm --filter @narraverse/desktop typecheck",
    "typecheck:mobile": "pnpm --filter @narraverse/mobile typecheck",
    "typecheck:all": "pnpm -r --filter @narraverse/frontend --filter @narraverse/backend --filter @narraverse/desktop --filter @narraverse/mobile run typecheck",
    "test": "pnpm --filter @narraverse/backend test",
    "commit": "git-cz",
    "prepare": "lefthook install",
    "release": "release-it",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:patch": "release-it patch",
    "release:beta": "release-it --preRelease=beta",
    "release:dry": "release-it --dry-run"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@release-it/conventional-changelog": "^8.0.2",
    "@shadcn/lint": "^0.1.1",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "lefthook": "^2.0.2",
    "lint-staged": "^16.2.6",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "release-it": "^17.9.0"
  }
}
